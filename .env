# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Put real values (APP_SECRET, database credentials, ...) in .env.local, which is ignored by git.

###> symfony/framework-bundle ###
APP_ENV=dev
# Set a long random value in .env.local for production, e.g. `php -r "echo bin2hex(random_bytes(16));"`
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URL used when generating absolute URLs outside of a web request (console commands).
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# SQLite is the default and needs no setup. To use another database, override DATABASE_URL in .env.local:
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfocms ###
# Name and tagline shown in the public theme, the feed and the admin area.
APP_SITE_NAME="SymfoCMS"
APP_SITE_TAGLINE="A small, friendly CMS"
# Language of the public website and default language of the admin area (en or de).
APP_LOCALE=en
# Time zone in which publish dates are entered and shown, e.g. Europe/Berlin.
# Choose it once before creating content: stored dates are not converted when it changes.
APP_TIMEZONE=UTC
# Number of earlier versions kept for every page and post (the oldest are removed).
APP_MAX_REVISIONS=50
# Sender address of emails the website sends. Use an address of your own domain.
APP_MAIL_FROM=noreply@example.com
# Maximum size of an uploaded image, in megabytes.
APP_MAX_UPLOAD_MB=8
###< symfocms ###

###> symfony/mailer ###
# How emails (notifications about form submissions) are sent. "null://null" sends nothing.
# Example: MAILER_DSN=smtp://user:password@smtp.example.com:587 - put real values in .env.local.
MAILER_DSN=null://null
###< symfony/mailer ###
