{% extends 'admin/base.html.twig' %}

{% block title %}{{ heading|trans }}{% endblock %}

{% block main %}
    <div class="page-header">
        <h1>{{ heading|trans }}</h1>
    </div>

    <div class="card card--narrow">
        <p class="muted">{{ intro|trans }}</p>
        {% if is_multilingual() %}
            <p><span class="locale-chip" lang="{{ locale }}">{{ locale_name(locale) }}</span> <span class="muted">{{ 'language.new_content_hint'|trans }}</span></p>
        {% endif %}
        {{ form_start(form) }}
        {{ form_widget(form) }}
        <div class="form-actions">
            <button type="submit" class="button button--primary">{{ 'action.continue'|trans }}</button>
            <a class="button" href="{{ back }}">{{ 'action.cancel'|trans }}</a>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
