{#
    Shared layout of the block editor, used for pages and posts.

    Child templates set: content, back_url, back_label, public_url
    and may fill the blocks "settings_main" and "settings_extra".
#}
{% extends 'admin/base.html.twig' %}

{% block title %}{{ content.title }}{% endblock %}
{% block body_class %}admin--editor{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/editor.css') }}">
{% endblock %}

{% block main %}
    {% set is_draft = content.status.value == 'draft' %}
    {# After a save that failed validation the editor shows what was typed, which is not stored yet. #}
    <div class="editor" data-controller="editor" data-editor-config-value="{{ editor_config|json_encode }}"
         data-editor-unsaved-value="{{ form.vars.submitted and not form.vars.valid ? 'true' : 'false' }}">
        {{ form_start(form, {attr: {
            'data-editor-target': 'form',
            'data-action': 'submit->editor#submit input->editor#fieldChanged change->editor#fieldChanged keydown->editor#preventImplicitSubmit',
        }}) }}

        <div class="editor__bar">
            <a class="editor__back" href="{{ back_url }}">← {{ back_label|trans }}</a>
            {% if is_multilingual() %}<span class="locale-chip" lang="{{ content.locale }}">{{ locale_name(content.locale) }}</span>{% endif %}
            <span class="editor__status" data-editor-target="status" role="status" aria-live="polite"></span>
            <div class="editor__bar-actions">
                <div class="segmented editor__view-switch" role="group" aria-label="{{ 'editor.view'|trans }}">
                    <button type="button" data-editor-target="viewButton" data-view="edit" data-action="editor#showView" aria-pressed="true">{{ 'editor.view_edit'|trans }}</button>
                    <button type="button" data-editor-target="viewButton" data-view="preview" data-action="editor#showView" aria-pressed="false">{{ 'editor.view_preview'|trans }}</button>
                </div>
                <a class="button" href="{{ public_url }}" target="_blank" rel="noopener">{{ (content.public ? 'editor.open_public' : 'editor.open_draft')|trans }} ↗</a>
                {% if is_draft %}
                    <button type="submit" class="button">{{ 'editor.save_draft'|trans }}</button>
                    <button type="submit" name="publish" value="1" class="button button--primary">{{ 'editor.publish'|trans }}</button>
                {% else %}
                    <button type="submit" class="button button--primary">{{ 'editor.save_changes'|trans }}</button>
                {% endif %}
            </div>
        </div>

        <div class="flash flash--info editor__restore" data-editor-target="restore" hidden>
            <span data-editor-target="restoreText"></span>
            <button type="button" class="link-button" data-action="editor#discardAutosave">{{ 'editor.restore_discard'|trans }}</button>
        </div>

        {% if form.vars.errors|length > 0 %}
            <div class="flash flash--error editor__errors">{{ form_errors(form) }}</div>
        {% endif %}

        <div class="editor__layout">
            <div class="editor__main">
                {{ form_row(form.title) }}

                <div class="tabs" role="tablist">
                    <button type="button" role="tab" id="editor-tab-content" aria-controls="editor-panel-content" data-editor-target="tab" data-tab="content" data-action="editor#showTab" aria-selected="true">{{ 'editor.tab_content'|trans }}</button>
                    <button type="button" role="tab" id="editor-tab-settings" aria-controls="editor-panel-settings" data-editor-target="tab" data-tab="settings" data-action="editor#showTab" aria-selected="false">{{ 'editor.tab_settings'|trans }}</button>
                    {# The history only becomes interesting once there is something to go back to. #}
                    {% if revisions|length > 1 %}
                        <button type="button" role="tab" id="editor-tab-history" aria-controls="editor-panel-history" data-editor-target="tab" data-tab="history" data-action="editor#showTab" aria-selected="false">{{ 'editor.tab_history'|trans }}</button>
                    {% endif %}
                </div>

                <div role="tabpanel" id="editor-panel-content" aria-labelledby="editor-tab-content" data-editor-target="panel" data-panel="content">
                    <div class="blocks" data-editor-target="list"></div>
                    <noscript><p class="flash flash--error">{{ 'editor.needs_javascript'|trans }}</p></noscript>
                </div>

                <div role="tabpanel" id="editor-panel-settings" aria-labelledby="editor-tab-settings" data-editor-target="panel" data-panel="settings" hidden>
                    <div class="card">
                        {% block settings_main %}{% endblock %}
                        {{ form_row(form.slug) }}
                        {{ form_row(form.status) }}
                        {% block settings_extra %}{% endblock %}
                        <h2 class="card__heading">{{ 'editor.seo_heading'|trans }}</h2>
                        <p class="muted">{{ 'editor.seo_intro'|trans }}</p>
                        {{ form_row(form.seoTitle) }}
                        {{ form_row(form.metaDescription) }}

                        {# Only on multilingual sites: the other language versions of this content. #}
                        {% if translations is not empty %}
                            <h2 class="card__heading">{{ 'language.translations_heading'|trans }}</h2>
                            <p class="muted">{{ 'language.translations_intro'|trans }}</p>
                            <ul class="translation-list">
                                {% for code, version in translations %}
                                    <li>
                                        <span class="locale-chip" lang="{{ code }}">{{ locale_name(code) }}</span>
                                        {% if version %}
                                            <span class="translation-list__title">{{ version.title }}</span>
                                            <a class="button button--small" href="{{ path(edit_route, {id: version.id}) }}">{{ 'language.edit_version'|trans }}</a>
                                        {% else %}
                                            <span class="translation-list__title muted">{{ 'language.no_version'|trans }}</span>
                                            {# Sends the editor form to the translate action; only the token below is read there. #}
                                            <button type="submit" class="button button--small" formnovalidate
                                                    formaction="{{ path(translate_route, {id: content.id, locale: code}) }}"
                                                    name="_token" value="{{ csrf_token('admin') }}">{{ 'language.translate_into'|trans({'%language%': locale_name(code)}) }}</button>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
                {% if revisions|length > 1 %}
                    <div role="tabpanel" id="editor-panel-history" aria-labelledby="editor-tab-history" data-editor-target="panel" data-panel="history" hidden>
                        <div class="card">
                            <p class="muted">{{ 'revision.intro'|trans({'%count%': max_revisions}) }}</p>
                            <ol class="revision-list">
                                {% for revision in revisions %}
                                    <li>
                                        <div class="revision-list__info">
                                            <strong>{{ revision.createdAt|local_date(true) }}</strong>
                                            <span class="muted">{{ revision.author ? revision.author.name : 'revision.unknown_author'|trans }}{% if revision.title != content.title %} · {{ revision.title }}{% endif %}</span>
                                        </div>
                                        {% if loop.first %}
                                            <span class="badge badge--published">{{ 'revision.current'|trans }}</span>
                                        {% else %}
                                            <a class="button button--small" href="{{ path(revision_route, {id: content.id, revision: revision.id}) }}" target="_blank" rel="noopener">{{ 'revision.preview'|trans }}</a>
                                            {# Sends the editor form to the restore action; only the token below is read there. #}
                                            <button type="submit" class="button button--small" formnovalidate
                                                    formaction="{{ path(revision_route ~ '_restore', {id: content.id, revision: revision.id}) }}"
                                                    name="_token" value="{{ csrf_token('admin') }}">{{ 'revision.restore'|trans }}</button>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ol>
                        </div>
                    </div>
                {% endif %}
            </div>

            <aside class="editor__preview" aria-label="{{ 'editor.preview_label'|trans }}">
                <div class="editor__preview-label">{{ 'editor.preview_label'|trans }}</div>
                {# allow-same-origin without allow-scripts: the editor can update the document, scripts inside never run. #}
                <iframe data-editor-target="preview" title="{{ 'editor.preview_label'|trans }}" sandbox="allow-same-origin"></iframe>
            </aside>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
