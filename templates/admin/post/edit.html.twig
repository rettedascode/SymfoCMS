{% extends 'admin/content/editor.html.twig' %}

{% set content = post %}
{% set back_url = path('admin_post_index', post.locale == default_content_locale() ? {} : {locale: post.locale}) %}
{% set back_label = 'nav.blog' %}
{% set public_url = content_path(post) %}
{% set edit_route = 'admin_post_edit' %}
{% set translate_route = 'admin_post_translate' %}

{% block settings_main %}
    {{ form_row(form.excerpt) }}
    {{ form_row(form.coverImage) }}
    {{ form_row(form.category) }}
    {% if form.author is defined %}{{ form_row(form.author) }}{% endif %}
    {{ form_row(form.publishedAt) }}
{% endblock %}
