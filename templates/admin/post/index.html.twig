{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'nav.blog'|trans }}{% endblock %}

{% block main %}
    <div class="page-header">
        <h1>{{ 'nav.blog'|trans }}</h1>
        <a class="button button--primary" href="{{ path('admin_post_new', {locale: locale}) }}">+ {{ 'post.new'|trans }}</a>
    </div>

    {{ include('admin/post/_tabs.html.twig', {active: 'posts', locale: locale}) }}

    {% if can_review and waiting > 0 %}
        <div class="flash flash--info" role="status">{{ 'review.waiting_count'|trans({'%count%': waiting}) }}</div>
    {% endif %}

    {% if posts is empty %}
        <div class="empty">
            <h2>{{ 'post.empty_title'|trans }}</h2>
            <p>{{ 'post.empty_text'|trans }}</p>
            <a class="button button--primary" href="{{ path('admin_post_new', {locale: locale}) }}">+ {{ 'post.new'|trans }}</a>
        </div>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">{{ 'label.title'|trans }}</th>
                    <th scope="col">{{ 'label.status'|trans }}</th>
                    <th scope="col">{{ 'post.category'|trans }}</th>
                    <th scope="col">{{ 'post.author'|trans }}</th>
                    <th scope="col">{{ 'post.date'|trans }}</th>
                    <th scope="col"><span class="visually-hidden">{{ 'label.actions'|trans }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for post in posts %}
                    {% set state = post.scheduled ? 'scheduled' : post.status.value %}
                    <tr>
                        <th scope="row"><a href="{{ path('admin_post_edit', {id: post.id}) }}">{{ post.title }}</a></th>
                        <td><span class="badge badge--{{ state }}">{{ ('status.' ~ state)|trans }}</span></td>
                        <td>{{ post.category ? post.category.name : '–' }}</td>
                        <td>{{ post.author ? post.author.name : '–' }}</td>
                        <td>{{ post.publishedAt ? post.publishedAt|local_date(true) : '–' }}</td>
                        <td class="table__actions">
                            <a class="button button--small" href="{{ path('admin_post_edit', {id: post.id}) }}">{{ 'action.edit'|trans }}</a>
                            <a class="button button--small" href="{{ content_path(post) }}" target="_blank" rel="noopener">{{ 'action.view'|trans }}</a>
                            {% if is_granted('POST_DELETE', post) %}
                                <form method="post" action="{{ path('admin_post_delete', {id: post.id}) }}" data-controller="confirm" data-confirm-message-value="{{ 'post.delete_confirm'|trans({'%title%': post.title}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                    <button class="button button--small button--danger">{{ 'action.delete'|trans }}</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
