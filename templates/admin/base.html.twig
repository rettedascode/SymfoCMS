<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}{{ 'admin.title'|trans }}{% endblock %} · {{ site_name }}</title>
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    {% block stylesheets %}{% endblock %}
    {{ importmap('admin') }}
</head>
<body class="admin {% block body_class %}{% endblock %}">
<a class="skip-link" href="#main">{{ 'admin.skip_to_content'|trans }}</a>
{% set route = app.request.attributes.get('_route', '') %}
<div class="shell" data-controller="sidebar">
    <header class="topbar">
        <button type="button" class="icon-button" data-action="sidebar#toggle" aria-controls="sidebar" aria-expanded="false" data-sidebar-target="button">
            <span aria-hidden="true">☰</span>
            <span class="visually-hidden">{{ 'admin.menu'|trans }}</span>
        </button>
        <span class="topbar__name">{{ site_name }}</span>
    </header>

    <aside class="sidebar" id="sidebar" data-sidebar-target="panel">
        <a class="sidebar__brand" href="{{ path('admin_dashboard') }}">{{ site_name }}</a>
        <nav aria-label="{{ 'admin.navigation'|trans }}">
            <ul class="sidebar__nav">
                {# NAV #}
                {% if is_granted('USER_MANAGE') %}
                    <li><a href="{{ path('admin_user_index') }}" {% if route starts with 'admin_user_' %}aria-current="page"{% endif %}><span aria-hidden="true">☺</span> {{ 'nav.users'|trans }}</a></li>
                {% endif %}
            </ul>
        </nav>
        <div class="sidebar__footer">
            <a href="{{ path('app_home') }}" target="_blank" rel="noopener">{{ 'nav.view_site'|trans }} ↗</a>
            <a href="{{ path('admin_account') }}" {% if route == 'admin_account' %}aria-current="page"{% endif %}>{{ app.user.name }}</a>
            <form method="post" action="{{ path('app_logout') }}">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}" data-controller="csrf-protection">
                <button type="submit" class="link-button">{{ 'nav.logout'|trans }}</button>
            </form>
        </div>
    </aside>

    <main class="main" id="main">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash flash--{{ type }}" role="status">{{ message|trans }}</div>
            {% endfor %}
        {% endfor %}
        {% block main %}{% endblock %}
    </main>
</div>
</body>
</html>
