{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'nav.settings'|trans }}
    <div class="card card--narrow table-wrap--spaced">
        <h2>{{ 'transfer.title'|trans }}</h2>
        <p class="muted">{{ 'transfer.settings_hint'|trans }}</p>
        <a class="button" href="{{ path('admin_transfer_index') }}">{{ 'transfer.open'|trans }}</a>
    </div>
{% endblock %}

{% block main %}
    <div class="page-header">
        <h1>{{ 'nav.settings'|trans }}</h1>
    </div>

    <div class="card card--narrow">
        {{ form_start(form) }}
        <h2>{{ 'settings.site_heading'|trans }}</h2>
        {{ form_row(form.siteName) }}
        {{ form_row(form.siteTagline) }}
        <h2 class="card__heading">{{ 'settings.languages_heading'|trans }}</h2>
        <p class="muted">{{ 'settings.languages_intro'|trans }}</p>
        {{ form_row(form.locales) }}
        <h2 class="card__heading">{{ 'settings.forms_heading'|trans }}</h2>
        {{ form_row(form.retentionDays) }}
        <h2 class="card__heading">{{ 'settings.security_heading'|trans }}</h2>
        {{ form_row(form.twoFactorAdmins) }}
        <h2 class="card__heading">{{ 'settings.api_heading'|trans }}</h2>
        {{ form_row(form.apiEnabled) }}
        {% if api_enabled %}
            <p class="muted">{{ 'settings.api_address'|trans }} <a href="{{ path('api_index') }}" target="_blank" rel="noopener"><code>{{ url('api_index') }}</code></a> · <a href="{{ path('api_openapi') }}" target="_blank" rel="noopener">{{ 'settings.api_description'|trans }}</a></p>
        {% endif %}
        <div class="form-actions">
            <button type="submit" class="button button--primary">{{ 'action.save'|trans }}</button>
        </div>
        {{ form_end(form) }}
    </div>

    <div class="card card--narrow table-wrap--spaced">
        <h2>{{ 'redirect.title'|trans }}</h2>
        <p class="muted">{{ 'redirect.settings_hint'|trans }}</p>
        <a class="button" href="{{ path('admin_redirect_index') }}">{{ 'redirect.manage'|trans }}</a>
    </div>

    <div class="card card--narrow table-wrap--spaced">
        <h2>{{ 'transfer.title'|trans }}</h2>
        <p class="muted">{{ 'transfer.settings_hint'|trans }}</p>
        <a class="button" href="{{ path('admin_transfer_index') }}">{{ 'transfer.open'|trans }}</a>
    </div>
{% endblock %}
