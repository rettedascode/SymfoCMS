{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'nav.settings'|trans }}{% endblock %}

{% block main %}
    <div class="page-header">
        <h1>{{ 'nav.settings'|trans }}</h1>
    </div>

    <div class="card card--narrow">
        <h2>{{ 'settings.languages_heading'|trans }}</h2>
        <p class="muted">{{ 'settings.languages_intro'|trans }}</p>
        {{ form_start(form) }}
        {{ form_row(form.locales) }}
        <h2 class="card__heading">{{ 'settings.forms_heading'|trans }}</h2>
        {{ form_row(form.retentionDays) }}
        <div class="form-actions">
            <button type="submit" class="button button--primary">{{ 'action.save'|trans }}</button>
        </div>
        {{ form_end(form) }}
    </div>

    <div class="card card--narrow table-wrap--spaced">
        <h2>{{ 'redirect.title'|trans }}</h2>
        <p class="muted">{{ 'redirect.settings_hint'|trans }}</p>
        <a class="button" href="{{ path('admin_redirect_index') }}">{{ 'redirect.manage'|trans }}</a>
    </div>
{% endblock %}
