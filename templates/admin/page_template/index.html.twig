{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'template.manage'|trans }}{% endblock %}

{% block main %}
    <div class="page-header">
        <h1>{{ 'template.manage'|trans }}</h1>
        <a class="button" href="{{ path('admin_page_index') }}">← {{ 'nav.pages'|trans }}</a>
    </div>

    <p class="muted">{{ 'template.manage_intro'|trans }}</p>

    {% if templates is empty %}
        <div class="empty">
            <h2>{{ 'template.empty_title'|trans }}</h2>
            <p>{{ 'template.empty_text'|trans }}</p>
        </div>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">{{ 'template.name'|trans }}</th>
                    <th scope="col">{{ 'template.created'|trans }}</th>
                    <th scope="col"><span class="visually-hidden">{{ 'label.actions'|trans }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for template in templates %}
                    <tr>
                        <th scope="row">{{ template.name }}</th>
                        <td>{{ template.createdAt|local_date(true) }}</td>
                        <td class="table__actions">
                            <form method="post" action="{{ path('admin_page_template_delete', {id: template.id}) }}" data-controller="confirm" data-confirm-message-value="{{ 'template.delete_confirm'|trans({'%name%': template.name}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <button class="button button--small button--danger">{{ 'action.delete'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
