{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'account.title'|trans }}{% endblock %}

{% block main %}
    <div class="page-header">
        <h1>{{ 'account.title'|trans }}</h1>
    </div>

    <div class="card card--narrow">
        {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.locale) }}
        <h2 class="card__heading">{{ 'account.change_password'|trans }}</h2>
        <p class="muted">{{ 'account.change_password_help'|trans }}</p>
        {{ form_row(form.currentPassword) }}
        {{ form_row(form.newPassword) }}
        <div class="form-actions">
            <button type="submit" class="button button--primary">{{ 'action.save'|trans }}</button>
        </div>
        {{ form_end(form) }}
    </div>

    <div class="card card--narrow table-wrap--spaced">
        <h2>{{ 'two_factor.title'|trans }}
            <span class="badge badge--{{ app.user.twoFactorEnabled ? 'published' : 'draft' }}">{{ (app.user.twoFactorEnabled ? 'two_factor.status_on' : 'two_factor.status_off')|trans }}</span>
        </h2>
        <p class="muted">{{ 'two_factor.intro'|trans }}</p>
        <a class="button" href="{{ path('admin_two_factor_index') }}">{{ (app.user.twoFactorEnabled ? 'two_factor.manage' : 'two_factor.set_up')|trans }}</a>
    </div>
{% endblock %}
