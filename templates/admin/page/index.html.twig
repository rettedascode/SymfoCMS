{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'nav.pages'|trans }}{% endblock %}

{% block main %}
    <div class="page-header">
        <h1>{{ 'nav.pages'|trans }}</h1>
        <div class="page-header__actions">
            {% if is_granted('TEMPLATE_MANAGE') %}<a class="button" href="{{ path('admin_page_template_index') }}">{{ 'template.manage'|trans }}</a>{% endif %}
            <a class="button button--primary" href="{{ path('admin_page_new', {locale: locale}) }}">+ {{ 'page.new'|trans }}</a>
        </div>
    </div>

    {{ include('admin/_locale_tabs.html.twig', {route: 'admin_page_index', current: locale}) }}

    {% if tree is empty %}
        <div class="empty">
            <h2>{{ 'page.empty_title'|trans }}</h2>
            <p>{{ 'page.empty_text'|trans }}</p>
            <a class="button button--primary" href="{{ path('admin_page_new', {locale: locale}) }}">+ {{ 'page.new'|trans }}</a>
        </div>
    {% else %}
        <p class="muted">{{ 'page.tree.intro'|trans }}</p>
        {#
            The pages as a tree. "tree" makes it draggable and collapsible (the collapsed branches are
            remembered per user), "page-tree" stores every move and asks before addresses change.
        #}
        <div data-controller="tree page-tree"
             data-tree-group-value="pages"
             data-tree-max-depth-value="{{ max_depth }}"
             data-tree-storage-value="pages-{{ app.user.id }}-{{ locale }}"
             data-page-tree-url-value="{{ path('admin_page_move') }}"
             data-page-tree-csrf-value="{{ csrf_token('admin') }}"
             data-page-tree-i18n-value="{{ {
                 confirm_title: 'page.tree.confirm_title'|trans,
                 confirm_ok: 'page.tree.confirm_ok'|trans,
                 confirm_cancel: 'page.tree.confirm_cancel'|trans,
                 moved: 'page.tree.moved'|trans,
                 moved_redirects: 'page.tree.moved_redirects'|trans,
             }|json_encode }}">
            {{ include('admin/page/_tree.html.twig', {nodes: tree, parent: null, depth: 1}) }}
        </div>
    {% endif %}
{% endblock %}
