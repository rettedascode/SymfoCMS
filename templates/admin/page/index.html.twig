{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'nav.pages'|trans }}{% endblock %}

{% block main %}
    <div class="page-header">
        <h1>{{ 'nav.pages'|trans }}</h1>
        <div class="page-header__actions">
            {% if is_granted('TEMPLATE_MANAGE') %}<a class="button" href="{{ path('admin_page_template_index') }}">{{ 'template.manage'|trans }}</a>{% endif %}
            <a class="button button--primary" href="{{ path('admin_page_new', {locale: locale}) }}">+ {{ 'page.new'|trans }}</a>
        </div>
    </div>

    {{ include('admin/_locale_tabs.html.twig', {route: 'admin_page_index', current: locale}) }}

    {% if pages is empty %}
        <div class="empty">
            <h2>{{ 'page.empty_title'|trans }}</h2>
            <p>{{ 'page.empty_text'|trans }}</p>
            <a class="button button--primary" href="{{ path('admin_page_new', {locale: locale}) }}">+ {{ 'page.new'|trans }}</a>
        </div>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th scope="col">{{ 'label.title'|trans }}</th>
                    <th scope="col">{{ 'label.status'|trans }}</th>
                    <th scope="col">{{ 'label.updated'|trans }}</th>
                    <th scope="col"><span class="visually-hidden">{{ 'label.actions'|trans }}</span></th>
                </tr>
                </thead>
                <tbody>
                {% for page in pages %}
                    <tr>
                        <th scope="row">
                            <a href="{{ path('admin_page_edit', {id: page.id}) }}">{{ page.title }}</a>
                            {% if page.homepage %}<span class="badge badge--home">{{ 'page.homepage_badge'|trans }}</span>{% endif %}
                        </th>
                        <td><span class="badge badge--{{ page.status.value }}">{{ page.status.label|trans }}</span></td>
                        <td>{{ page.updatedAt|local_date(true) }}</td>
                        <td class="table__actions">
                            <a class="button button--small" href="{{ path('admin_page_edit', {id: page.id}) }}">{{ 'action.edit'|trans }}</a>
                            <a class="button button--small" href="{{ content_path(page) }}" target="_blank" rel="noopener">{{ 'action.view'|trans }}</a>
                            <form method="post" action="{{ path('admin_page_delete', {id: page.id}) }}" data-controller="confirm" data-confirm-message-value="{{ 'page.delete_confirm'|trans({'%title%': page.title}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <button class="button button--small button--danger">{{ 'action.delete'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
