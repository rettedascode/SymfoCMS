{% extends 'admin/content/editor.html.twig' %}

{% set content = page %}
{% set back_url = path('admin_page_index', page.locale == default_content_locale() ? {} : {locale: page.locale}) %}
{% set back_label = 'nav.pages' %}
{% set public_url = content_path(page) %}
{% set edit_route = 'admin_page_edit' %}
{% set translate_route = 'admin_page_translate' %}
{% set revision_route = 'admin_page_revision' %}
{% set seo_base_url = site_url('app_page', {slug: 'slug-placeholder'}, page.locale)|replace({'slug-placeholder': ''}) %}

{% block settings_extra %}
    {{ form_row(form.homepage) }}
{% endblock %}

{% block settings_end %}
    {# Admins can keep this page as a starting point for new pages. #}
    {% if is_granted('TEMPLATE_MANAGE') %}
        <h2 class="card__heading">{{ 'template.save_heading'|trans }}</h2>
        <p class="muted">{{ 'template.save_intro'|trans }}</p>
        <div class="inline-form">
            <div class="field">
                <label for="template_name">{{ 'template.name'|trans }}</label>
                {# Not part of the page form: it is only read by the "save as template" action. #}
                <input type="text" id="template_name" name="template_name" maxlength="120" placeholder="{{ page.title }}" data-editor-ignore>
            </div>
            <button type="submit" class="button" formnovalidate
                    formaction="{{ path('admin_page_template_create', {id: page.id}) }}"
                    name="_token" value="{{ csrf_token('admin') }}">{{ 'template.save_button'|trans }}</button>
        </div>
        <p class="field__help"><a href="{{ path('admin_page_template_index') }}">{{ 'template.manage'|trans }}</a></p>
    {% endif %}
{% endblock %}
