{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'post.tab_categories'|trans }}{% endblock %}

{% block main %}
    <div class="page-header">
        <h1>{{ 'nav.blog'|trans }}</h1>
    </div>

    {{ include('admin/post/_tabs.html.twig', {active: 'categories', locale: locale}) }}

    <div class="card card--narrow">
        <h2>{{ 'category.add'|trans }}</h2>
        {{ form_start(form, {attr: {class: 'inline-form inline-form--top'}}) }}
        {{ form_row(form.name) }}
        <button type="submit" class="button button--primary">{{ 'category.add_button'|trans }}</button>
        {{ form_end(form) }}
    </div>

    {% if categories is not empty %}
        <p class="muted list-hint">{{ 'category.order_hint'|trans }}</p>
        {# The order is stored with every move (see sortable_controller.js) and is the order on the blog. #}
        <ul class="sort-list" data-controller="sortable" data-sortable-group-value="categories"
            data-sortable-url-value="{{ path('admin_category_move') }}" data-sortable-csrf-value="{{ csrf_token('admin') }}"
            aria-label="{{ 'post.tab_categories'|trans }}">
            {% for category in categories %}
                <li class="sort-list__item" data-dnd-item data-dnd-id="{{ category.id }}" data-dnd-label="{{ category.name }}">
                    <button type="button" class="dnd-handle" data-dnd-handle aria-haspopup="menu"
                            aria-label="{{ 'dnd.handle'|trans({'%item%': category.name}) }}" title="{{ 'dnd.handle_hint'|trans }}">
                        <svg class="icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="currentColor"><circle cx="9" cy="6" r="1.4"/><circle cx="15" cy="6" r="1.4"/><circle cx="9" cy="12" r="1.4"/><circle cx="15" cy="12" r="1.4"/><circle cx="9" cy="18" r="1.4"/><circle cx="15" cy="18" r="1.4"/></svg>
                    </button>
                    <a class="sort-list__title" href="{{ path('admin_category_edit', {id: category.id}) }}">{{ category.name }}</a>
                    <span class="sort-list__detail muted">{{ site_path('app_blog_category', {slug: category.slug}, category.locale) }}</span>
                    <span class="sort-list__actions">
                        <a class="button button--small" href="{{ path('admin_category_edit', {id: category.id}) }}">{{ 'action.edit'|trans }}</a>
                        <form method="post" action="{{ path('admin_category_delete', {id: category.id}) }}" data-controller="confirm" data-confirm-message-value="{{ 'category.delete_confirm'|trans({'%name%': category.name}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                            <button class="button button--small button--danger">{{ 'action.delete'|trans }}</button>
                        </form>
                    </span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
