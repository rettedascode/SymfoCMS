<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ 'two_factor.challenge.heading'|trans }} · {{ site_name }}</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
</head>
<body class="admin login">
<main class="login__card">
    <h1>{{ 'two_factor.challenge.heading'|trans }}</h1>
    <p class="muted">{{ 'two_factor.challenge.intro'|trans }}</p>

    {% if error %}
        <div class="flash flash--error" role="alert">{{ error|trans }}</div>
    {% endif %}

    <form method="post" action="{{ path('app_two_factor') }}">
        <div class="field">
            <label for="two-factor-code">{{ 'two_factor.code'|trans }}</label>
            <input type="text" class="code-input" id="two-factor-code" name="code" inputmode="numeric" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" maxlength="20" required autofocus>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="button button--primary button--block">{{ 'two_factor.challenge.submit'|trans }}</button>
    </form>

    <form method="post" action="{{ path('app_logout') }}" class="login__back">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button type="submit" class="link-button">{{ 'two_factor.challenge.logout'|trans }}</button>
    </form>
</main>
</body>
</html>
