<!DOCTYPE html>
<html lang="{{ app.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% set page_title = block('title') is defined ? block('title')|trim : '' %}
    {% set full_title = page_title and page_title != site_name ? page_title ~ ' – ' ~ site_name : site_name %}
    {% set description = meta_description|default(site_tagline) %}
    {% set canonical = canonical_url|default(null) %}
    <title>{{ full_title }}</title>
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}
    {% if noindex|default(false) %}<meta name="robots" content="noindex">{% endif %}
    {% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
    <meta property="og:site_name" content="{{ site_name }}">
    <meta property="og:title" content="{{ page_title ?: site_name }}">
    <meta property="og:type" content="{{ og_type|default('website') }}">
    {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
    {% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
    {% if og_image|default(null) %}<meta property="og:image" content="{{ og_image }}">{% endif %}
    <meta name="twitter:card" content="{{ og_image|default(null) ? 'summary_large_image' : 'summary' }}">
    {# Tell search engines about the other language versions of this page. #}
    {% for hreflang, href in (translatable|default(null) ? content_alternates(translatable) : {}) %}
        <link rel="alternate" hreflang="{{ hreflang }}" href="{{ href }}">
    {% endfor %}
    <link rel="alternate" type="application/rss+xml" title="{{ site_name }}" href="{{ site_path('app_feed') }}">
    {% block head %}{% endblock %}
    <link rel="icon" type="image/svg+xml" href="{{ asset('images/favicon.svg') }}">
    <link rel="stylesheet" href="{{ asset('styles/site.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<a class="skip-link" href="#content">{{ 'site.skip_to_content'|trans }}</a>

{% block edit_bar %}
    {% if is_granted('ROLE_AUTHOR') %}
        <div class="edit-bar">
            <div class="container">
                <span>
                    {% if is_draft|default(false) %}<span class="edit-bar__draft">{{ 'site.draft_notice'|trans }}</span>{% endif %}
                    {{ 'site.logged_in_as'|trans({'%name%': app.user.name}) }}
                </span>
                <span>
                    {% if edit_url|default(null) %}<a href="{{ edit_url }}">{{ 'site.edit_this'|trans }}</a> ·{% endif %}
                    <a href="{{ path('admin_dashboard') }}">{{ 'site.to_admin'|trans }}</a>
                </span>
            </div>
        </div>
    {% endif %}
{% endblock %}

<header class="site-header">
    <div class="container">
        <a class="site-brand" href="{{ site_path('app_home') }}">{{ site_name }}</a>
        {% block navigation %}
            {% set main_menu = cms_menu('main') %}
            {% if main_menu is not empty %}
                <nav class="site-nav" aria-label="{{ 'site.main_navigation'|trans }}">
                    <button type="button" class="site-nav__toggle" aria-expanded="false" aria-controls="site-menu">
                        <span aria-hidden="true">☰</span> {{ 'site.menu'|trans }}
                    </button>
                    <ul class="site-nav__list" id="site-menu">
                        {% for item in main_menu %}
                            <li{% if item.children is not empty %} class="has-children"{% endif %}>
                                <a href="{{ item.url }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a>
                                {% if item.children is not empty %}
                                    <button type="button" class="site-nav__sub-toggle" aria-expanded="false" aria-label="{{ 'site.submenu'|trans({'%label%': item.label}) }}">▾</button>
                                    <ul class="site-nav__sub">
                                        {% for child in item.children %}
                                            <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.label }}</a></li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        {% endblock %}
        {% block language_switcher %}
            {# Empty on single-language sites. Links to the same page in the other language where it exists. #}
            {% set languages = language_switcher(translatable|default(null), switch_route|default('app_home')) %}
            {% if languages is not empty %}
                <nav class="language-switcher" aria-label="{{ 'site.languages'|trans }}">
                    <ul>
                        {% for language in languages %}
                            <li><a href="{{ language.url }}" lang="{{ language.locale }}" hreflang="{{ language.locale }}"{% if language.current %} aria-current="true"{% endif %}>{{ language.name }}</a></li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        {% endblock %}
    </div>
</header>

<main class="site-main" id="content">
    {% block main %}
        <div class="container container--narrow">
            {% block content %}{% endblock %}
        </div>
    {% endblock %}
</main>

<footer class="site-footer">
    <div class="container">
        <p>© {{ 'now'|date('Y') }} {{ site_name }}</p>
        {% block footer_navigation %}
            {% set footer_menu = cms_menu('footer') %}
            {% if footer_menu is not empty %}
                <nav aria-label="{{ 'site.footer_navigation'|trans }}">
                    <ul class="footer-nav">
                        {% for item in footer_menu %}
                            <li><a href="{{ item.url }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        {% endblock %}
    </div>
</footer>

{% block javascripts %}
    <script src="{{ asset('site.js') }}" defer></script>
{% endblock %}
</body>
</html>
