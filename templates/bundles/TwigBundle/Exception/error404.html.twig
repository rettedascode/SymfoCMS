{# Friendly "page not found" in the public theme. Preview it in dev at /_error/404. #}
{% extends 'site/base.html.twig' %}

{% set noindex = true %}

{% block title %}{{ 'error.not_found_title'|trans }}{% endblock %}

{% block content %}
    <div class="error-page">
        <p class="error-page__code" aria-hidden="true">404</p>
        <h1>{{ 'error.not_found_title'|trans }}</h1>
        <p>{{ 'error.not_found_text'|trans }}</p>
        <p>
            <a class="button button--primary" href="{{ path('app_home') }}">{{ 'error.to_homepage'|trans }}</a>
        </p>
    </div>
{% endblock %}
