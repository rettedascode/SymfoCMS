{# Rendered into the live preview frame of the editor. #}
{% extends 'site/base.html.twig' %}

{% set noindex = true %}

{% block title %}{{ title }}{% endblock %}

{% block stylesheets %}
    {# The preview is for looking, not for navigating away from the editor. #}
    <style>a { pointer-events: none; }</style>
{% endblock %}

{% block edit_bar %}
    {% if revision|default(null) %}
        <div class="edit-bar"><div class="container"><span><span class="edit-bar__draft">{{ 'revision.preview_notice'|trans }}</span> {{ revision.createdAt|local_date(true) }}{% if revision.author %} · {{ revision.author.name }}{% endif %}</span></div></div>
    {% endif %}
{% endblock %}
{% block javascripts %}{% endblock %}

{% block content %}
    <article class="content">
        {% if kind == 'post' %}
            <header class="post-header"><h1>{{ title }}</h1></header>
        {% elseif kind == 'fragment' %}
            {# A shared block is shown on its own, without a page title. #}
        {% else %}
            <h1 class="page-title">{{ title }}</h1>
        {% endif %}
        {{ render_blocks(blocks) }}
    </article>
{% endblock %}
